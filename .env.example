# 서버에서 .env 로 복사한 뒤 값을 채운다.

# 서비스 주소
NEXT_PUBLIC_APP_URL=https://fightiq.runvia.app

# 호스트 nginx 가 프록시할 포트 (127.0.0.1 에만 열림)
APP_PORT=6060

# 함께 뜨는 PostgreSQL 비밀번호 (openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Firebase 웹 앱 설정 (선택). 비워 두면 로그인 기능 없이 비회원(브라우저 쿠키)으로만 동작한다.
# 켤 때: Firebase 콘솔 → Authentication 에서 Google 사용, 승인된 도메인에 fightiq.runvia.app 추가 → 값 입력 → ./deploy.sh
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 관리자 (/admin). 로그인(Firebase)을 안 쓸 때는 비밀번호로 들어간다: /admin/login (8자 이상, openssl rand -hex 16)
ADMIN_PASSWORD=
# 로그인을 쓸 때는 구글 계정으로도 (쉼표 구분)
ADMIN_EMAILS=

# 로컬 개발 전용 (npm run dev): 로컬 Postgres 주소
# DATABASE_URL=postgres://fightiq:fightiq@localhost:5432/fightiq

# --- AI 문제 생성 워커 (docs/샘플문제_평가.md) ---
# desktop-ai 의 API_KEYS 에 fightiq:<키> 를 추가하고 NVIDIA_CLIENTS 에도 fightiq 를 넣은 뒤 같은 키를 여기에.
# 비워 두면 워커를 띄우지 않는다.
FIQ_BRIDGE_KEY=
# FIQ_BRIDGE_URL=http://junlab-ai:8000
# 생성 시간대 (KST, 시작-끝 시). 코딩 사용이 적은 새벽
WORKER_HOURS=1-8
# 한 번에 처리할 주제 수 / 하루 최대 시도 수
WORKER_BATCH=6
WORKER_DAILY_CANDIDATES=120
# 워커 자체 분당 호출 한도, 브릿지 전체 NVIDIA 사용률이 이보다 높으면 대기 (코딩 작업 우선)
WORKER_MAX_RPM=15
WORKER_MAX_BRIDGE_SHARE=0.5
# 안전한 칸(규칙·기술·역사·단체·용어 + 1등급 출처 + 블라인드 2/2)은 바로 게시. off 면 전부 검수 대기
WORKER_AUTO_PUBLISH=on
